# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature Flags & Quality Toggles
NEXT_PUBLIC_ENABLE_AUDIO=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_LOG_LEVEL=debug

# Email Delivery Service (Optional: for server actions/contact form delivery)
# RESEND_API_KEY=re_123456789
# CONTACT_EMAIL=alishba@example.com

# AI Chatbot LLM Integration (Optional: for Google Gemini LLM API generation)
# GEMINI_API_KEY=your_gemini_api_key_here

# Bot Protection (Optional: for contact form spam defense)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
